{
  "manifest_version": 3,
  "name": "Linkerlee Bookmarker",
  "version": "0.9.4",
  "description": "Save the current tab to Linkerlee with suggested tags.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["https://linkerlee.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "src/background/background.ts",
    "scripts": ["src/background/background.ts"],
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Save to Linkerlee"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "linkerlee-bookmarker@linkerlee.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["websiteContent"] }
    }
  }
}
